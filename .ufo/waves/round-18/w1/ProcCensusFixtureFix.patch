+def spawn_deleted_stdout(argv, cwd, label):
+    root = Path(tempfile.mkdtemp(prefix="souji-r18-proc-fd-{}.".format(label), dir="/var/tmp"))
+    EXTRA_DIRS.append(root)
+    path = root / "stdout"
