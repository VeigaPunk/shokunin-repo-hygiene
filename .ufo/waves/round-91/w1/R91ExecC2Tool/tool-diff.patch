+def _utf8_seq_need(b: int) -> int:
+    """The octet count of a UTF-8 sequence whose initial octet is `b`, or 0 when `b` cannot start one."""
+    if 0xC0 <= b < 0xE0:
+        return 2
+    if 0xE0 <= b < 0xF0:
+        return 3
+    if 0xF0 <= b < 0xF8:
+        return 4
+    return 0
+
