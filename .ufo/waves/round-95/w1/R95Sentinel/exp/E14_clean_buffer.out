[buffer+os._exit plain ] rc=0 stdout='' stderr=''
[buffer+os._exit hooked] rc=70 stdout='BUFFERED-NOT-FLUSHED' stderr='ERR-NOT-FLUSHEDSOUJI-R95-CRASH os._exit(0)'
[fork-dup       plain ] rc=0 stdout='PARENT-BUFFERED-TEXT|PARENT-AFTER' stderr=''
[fork-dup       hooked] rc=0 stdout='PARENT-BUFFERED-TEXTPARENT-BUFFERED-TEXT|PARENT-AFTER' stderr='SOUJI-R95-CRASH os._exit(0)'
