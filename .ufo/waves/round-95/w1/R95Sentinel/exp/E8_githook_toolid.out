[git-hook plain ] rc=1 out='HOOK os._exit is _exit\nHOOK excepthook is excepthook\nHOOK tool3 owner: None\nOn branch main\n\nInitial commit\n\nUntracked files:\n  (use "git add <file>..." to include in what will be committed)\n\ta.txt\n\nnothing added to commit but untracked files present (use "git add" to track)'
[git-hook hooked] rc=1 out='HOOK os._exit is _souji_os_exit\nHOOK excepthook is _souji_excepthook\nHOOK tool3 owner: souji-r95-sentinel\nOn branch main\n\nInitial commit\n\nUntracked files:\n  (use "git add <file>..." to include in what will be committed)\n\ta.txt\n\nnothing added to commit but untracked files present (use "git add" to tr'
[tool-id plain ] rc=0 out='tool 3: None | 4: None | 5: None\nOPTIMIZER_ID: 5 COVERAGE_ID: 1' err=''
[tool-id hooked] rc=0 out='tool 3: souji-r95-sentinel | 4: None | 5: None\nOPTIMIZER_ID: 5 COVERAGE_ID: 1' err=''
