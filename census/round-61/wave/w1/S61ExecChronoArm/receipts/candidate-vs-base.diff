+def control_red(blob):
+    """True when the receipt's last non-blank line is EXIT=<nonzero>."""
+    lines = [x.strip() for x in blob.decode("utf-8", "replace").splitlines() if x.strip()]
+    m = EXIT_LINE.match(lines[-1]) if lines else None
+    return bool(m and int(m.group(1)) != 0)
+
+
+def control_chronology(repo, freeze, label, path):
+    """r61 --substance: the Control receipt must be ADDED by a strict ancestor of the freeze commit.
+
+    `git log` lists newest first, so the oldest commit reachable from FREEZE that adds PATH is the
+    last id listed. A receipt committed with the preregistration (the r60 rejection shape) is added
+    by FREEZE itself, which is not a strict ancestor of FREEZE, so it is refused here.
+    """
+    p = repo.run("log", "--diff-filter=A", "--no-renames", "--full-history", "--format=%H",
+                 freeze, "--", path)
+    ids = p.stdout.decode("utf-8", "replace").split() if p.returncode == 0 else []
+    if not ids:
+        return [(label, "CONTROL-ADDED-NOT-BEFORE-FREEZE",
+                 "%s has no adding commit reachable from freeze %s" % (path, freeze[:12]))]
+    added = ids[-1]
+    if not FULL40.match(added):
+        return [(label, "CONTROL-ADDED-NOT-BEFORE-FREEZE",
+                 "%s adding commit %r is not a full 40-hex id" % (path, added))]
+    if added == freeze or not repo.is_ancestor(added, freeze):
+        return [(label, "CONTROL-ADDED-NOT-BEFORE-FREEZE",
+                 "%s added at %s, not a strict ancestor of freeze %s" % (path, added[:12], freeze[:12]))]
+    return []
+
