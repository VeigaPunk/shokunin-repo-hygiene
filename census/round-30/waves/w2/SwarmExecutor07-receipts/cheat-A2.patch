-printf 'jj-version: %s\n' "$(jj --version)"
-printf 'git-version: %s\n' "$(git --version)"
-
-BASE=$(mktemp -d "$TMPDIR/r30-jj-keep-expiry.XXXXXX") || die "mktemp failed under $TMPDIR"
-case "$(cd "$BASE" && pwd -P)" in
