# row PK3 expect=refuse class=lane worktree is dirty cwd=root note=repo-local core.excludesFile hides untracked
PROP PK3 slot=base expect=refuse verdict=accept class=- rc=0 stderr=''
# row PK3h expect=accept class=- cwd=root note=honest control: same excludes config, no untracked file
PROP PK3h slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PK4 expect=refuse class=lane worktree is dirty cwd=root note=global core.fileMode=false hides tracked 755->644
PROP PK4 slot=base expect=refuse verdict=accept class=- rc=0 stderr=''
# row PK4h expect=accept class=- cwd=root note=honest control: same global config, no mode change
PROP PK4h slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PK6 expect=refuse class=- cwd=root note=replace ref forges HEAD's instrument tree
PROP PK6 slot=base expect=refuse verdict=refuse class=- rc=2 stderr='refused: lane worktree is dirty (git status --porcelain non-empty); pass --allow-dirty to override'
# row PK6h expect=accept class=- cwd=root note=honest control: no replace ref
PROP PK6h slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PK7 expect=refuse class=lane worktree is dirty cwd=root note=GIT_CONFIG_SYSTEM core.fileMode=false hides 755->644
PROP PK7 slot=base expect=refuse verdict=refuse class=lane worktree is dirty rc=2 stderr='refused: lane worktree is dirty (git status --porcelain non-empty); pass --allow-dirty to override'
# row PK7h expect=accept class=- cwd=root note=honest control: same system config, no mode change
PROP PK7h slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PCD-alias expect=accept class=- cwd=root note=symlink GIT_COMMON_DIR equal after canonicalization
PROP PCD-alias slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PCD-rel expect=accept class=- cwd=root note=relative '.git' run from the root
PROP PCD-rel slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PCD-up expect=accept class=- cwd=tools note=relative '../.git' run from tools/ (cwd-relative)
PROP PCD-up slot=base expect=accept verdict=accept class=- rc=0 stderr=''
# row PCD-empty expect=refuse class=RECEIPT-ENV-COMMONDIR-MISMATCH cwd=gitdir note=empty value, cwd == common dir
PROP PCD-empty slot=base expect=refuse verdict=refuse class=RECEIPT-ENV-COMMONDIR-MISMATCH rc=2 stderr="refused: RECEIPT-ENV-COMMONDIR-MISMATCH: GIT_COMMON_DIR is set in the writer's environment and does not resolve to this repository's common dir (value not shown); unset it and retry"
# row PRL-fm expect=accept class=- cwd=root note=measured L1 limit: repo-local core.fileMode=false hides a mode change (not a kill target)
PROP PRL-fm slot=base expect=accept verdict=accept class=- rc=0 stderr=''
EXIT=0
