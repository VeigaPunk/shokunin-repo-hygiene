-  case "$kill_tmp_dir" in "${TMPDIR:-/tmp}"/souji-census-now.*) rm -rf -- "$kill_tmp_dir" ;; esac
+  case "$kill_tmp_dir" in "${CENSUS_TMP_ROOT}"/souji-census-now.*) rm -rf -- "$kill_tmp_dir" ;; esac
 
 
