 "key_findings": [
  {
   "id": "s1-absent-vault-digest",
   "family": "s",
   "severity": "critical",
   "finding": "A DIRECTORY ledger row whose vault_sha256 column is absent or empty verifies as SAFE(moved-to-obsidian) even when the vault copy does not match the source. The tool reports 'ledger=source+vault-digest' while never computing the vault digest.",
   "root_cause": "try_obsidian parses rows with `IFS=$'\\t' read -r sp ss vp vs _rest`. Bash IFS whitespace collapses runs of tabs, so a row with an empty/absent 4th field shifts the remaining columns left and leaves vs empty; the guard `[ -n \"$vs\" ]` then SKIPS the vault-digest comparison instead of failing. Proved independently: bash read gives sp=[SRC] ss=[VAULT] vp=[date] vs=[x]; awk -F'\\t' gives sp=[SRC] ss=[] vp=[VAULT] vs=[].",
   "affected_tools": [
    "r2-installed"
   ],
   "cases": [
    "C2",
    "C3"
   ],
   "evidence": "C2: 3-field dir row, vault digest differs -> `VERDICT /tmp/s55-cross2/src/dx SAFE moved-to-obsidian ledger=source+vault-digest vault=/tmp/s55-cross2/vault/dx` (exit 0). C3: same shape with matching content -> also SAFE."
  },
  {
   "id": "u1-torn-append-false-safe",
   "family": "u",
   "severity": "critical",
   "finding": "The s1 defect is reachable by CONCURRENCY alone: a writer that appends a dir row in two write() calls leaves a complete 3-field row readable for a window, and every evaluation during that window returns SAFE while the vault content differs. After the tail lands (with a WRONG digest) the verdict STILL stays SAFE, because the collapsed 3-field row is now a complete line in the file.",
   "affected_tools": [
    "r2-installed"
   ],
   "cases": [
    "C22"
   ],
   "evidence": "C22 r2-installed: verified=40/40 with every complete row carrying digest 0000...0000; supporting probe4 E1 verified=260/260; E2 (static, post-tail) still SAFE. impl-20 / impl-24 / impl-21: 0/40."
  },
  {
   "id": "s2-self-move-receipt",
   "family": "s",
   "severity": "critical",
   "finding": "A row whose vault_path equals its own source_path verifies as moved-to-obsidian. The receipt names no second copy: acting on it removes the artifact's only copy.",
   "affected_tools": [
    "r2-installed",
    "impl-24",
    "impl-21"
   ],
   "cases": [
    "C7",
