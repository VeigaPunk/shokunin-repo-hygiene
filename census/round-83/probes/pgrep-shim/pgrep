#!/bin/sh
# r83 probe shim: count pgrep invocations a tool makes during one counter row. Log path comes from
# R83PGREP_LOG (not SOUJI_*, which the C2 counter strips from the tool's environment); the real binary is
# resolved from /usr/bin so the shim cannot recurse.
[ -n "${R83PGREP_LOG:-}" ] && printf 'pgrep %s\n' "$*" >> "$R83PGREP_LOG"
exec /usr/bin/pgrep "$@"
